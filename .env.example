# Local dev database from docker-compose.yml (port 5433 avoids clashing with a host Postgres)
DATABASE_URL=postgres://ztarz:ztarz@localhost:5433/ztarz

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The single owner account, created by `pnpm owner:create`
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
