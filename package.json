{
  "name": "ztarz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "dev": "pnpm content && next dev",
    "build": "pnpm content && next build",
    "start": "cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/ && node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "owner:create": "tsx --conditions=react-server scripts/create-owner.ts",
    "test:e2e": "playwright test",
    "dev:e2e": "pnpm content && tsx e2e/dev.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.3",
    "@trpc/client": "^11.29.7",
    "@trpc/server": "^11.29.7",
    "@trpc/tanstack-react-query": "^11.29.7",
    "better-auth": "^1.7.27",
    "client-only": "^0.0.1",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.7",
    "ts-fsrs": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "simple-icons": "16.37.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
