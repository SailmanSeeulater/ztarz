# Copy to .env in the checkout on the server (~/ztarz/.env). Never commit it.
# Compose reads it for the database settings and the image tag; the app gets it via env_file.
COMPOSE_FILE=compose.prod.yml

POSTGRES_USER=ztarz
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=ztarz

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://ztarz.latesailor.dev
APP_TIMEZONE=America/Los_Angeles

# Written by each deploy: the commit the server runs.
ZTARZ_TAG=latest
