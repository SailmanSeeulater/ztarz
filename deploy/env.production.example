# Copy to .env.production in the repo root on the server. Never commit it.
DOMAIN=ztarz.example.com
LETSENCRYPT_EMAIL=you@example.com

POSTGRES_USER=ztarz
# openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=ztarz
# Same password as above; "db" is the compose service name.
DATABASE_URL=postgres://ztarz:CHANGE_ME@db:5432/ztarz

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://ztarz.example.com
APP_TIMEZONE=America/Los_Angeles

OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
